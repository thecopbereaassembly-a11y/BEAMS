# ── BEAMS environment (see docs/14-devops-deployment-dr.md §5) ──────────────
# Copy to .env.local for development. NEVER commit real secrets.

# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Server-only (NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
CREDENTIAL_ENCRYPTION_KEY=
CRON_SECRET=

# ── Ghana integrations (server-only) ───────────────────────────────────────
# Leave these blank and BEAMS uses a dry-run provider: sends are recorded as
# "simulated" and nothing reaches a real phone or inbox.
#
# SMS — set EITHER Arkesel OR Hubtel (Arkesel wins if both are present)
# ARKESEL_API_KEY=
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# SMS_SENDER_ID=BEAMS
# ARKESEL_RATE_GHS=0.035        # per SMS segment, for the cost estimate
# HUBTEL_RATE_GHS=0.04

# Email
# RESEND_API_KEY=
# EMAIL_FROM=BEAMS <noreply@yourdomain.com>

# Mobile Money (M7)
# MOMO_API_KEY=

# Observability
# SENTRY_DSN=
